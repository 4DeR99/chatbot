{
	"name": "server",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@ai-sdk/google": "catalog:",
		"@hono/trpc-server": "^0.4.0",
		"@repo/api": "workspace:*",
		"@repo/auth": "workspace:*",
		"@repo/db": "workspace:*",
		"@trpc/server": "catalog:",
		"ai": "catalog:",
		"ai-sdk-ollama": "^1.0.2",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@repo/config": "workspace:*",
		"@types/bun": "^1.2.6",
		"tsdown": "^0.16.5",
		"typescript": "^5.8.2"
	}
}
